<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="flowfinance_db"/>
        <exclude domain="database" path="flowfinance_db-shm"/>
        <exclude domain="database" path="flowfinance_db-wal"/>
        <exclude domain="database" path="flowfinance_db-journal"/>
        <exclude domain="datastore" path="settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="flowfinance_db"/>
        <exclude domain="database" path="flowfinance_db-shm"/>
        <exclude domain="database" path="flowfinance_db-wal"/>
        <exclude domain="database" path="flowfinance_db-journal"/>
        <exclude domain="datastore" path="settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>